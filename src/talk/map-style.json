{
  "version": 8,
  "name": "INU Amber",
  "metadata": {
    "inu:note": "Vector tiles, not a filtered raster. Road class is drawn as heat: motorways run at the studio's own orange and each step down the hierarchy cools and narrows, so the shape of the city is readable at a glance. Labels are SDF text, which is why they stay sharp on a retina screen where 256px rasters were being upscaled into mush."
  },
  "glyphs": "https://tiles.openfreemap.org/fonts/{fontstack}/{range}.pbf",
  "sources": {
    "of": {
      "type": "vector",
      "url": "https://tiles.openfreemap.org/planet",
      "attribution": "<a href=\"https://openfreemap.org\" target=\"_blank\" rel=\"noopener\">OpenFreeMap</a> · <a href=\"https://www.openmaptiles.org/\" target=\"_blank\" rel=\"noopener\">OpenMapTiles</a> · <a href=\"https://www.openstreetmap.org/copyright\" target=\"_blank\" rel=\"noopener\">OSM</a>"
    }
  },
